<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.Shuttle">

        <service
            android:name=".gps.GpsTrackerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <activity
            android:name="com.shuttle.mobile.ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.shuttle.mobile.ui.LoginActivity"
            android:exported="false" />
        <activity
            android:name="com.shuttle.mobile.ui.RegisterActivity"
            android:exported="false" />
        <activity
            android:name="com.shuttle.mobile.ui.DriverActivity"
            android:exported="false" />
        <activity
            android:name="com.shuttle.mobile.ui.OperatorActivity"
            android:exported="false" />
        <activity
            android:name="com.shuttle.mobile.ui.ShiftSummaryActivity"
            android:exported="false" />
    </application>

</manifest>