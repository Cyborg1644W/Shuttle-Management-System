<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Fleet.ShiftFieldLabel" parent="Fleet.AuthLabel">
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="Fleet.ShiftPickerField" parent="Fleet.Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/text_secondary</item>
        <item name="android:background">@drawable/input_bg</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
