<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <com.shuttle.mobile.ui.FleetBackdropView android:layout_width="match_parent" android:layout_height="match_parent" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp"
            android:paddingTop="64dp" android:paddingBottom="48dp">
            <include layout="@layout/view_auth_brand" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center_horizontal" />
            <TextView style="@style/Fleet.Title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="40dp" android:text="@string/welcome_back" android:textStyle="normal"
                android:fontFamily="@font/arimo_variable" android:textSize="23sp" />
            <LinearLayout android:id="@+id/layoutEmail" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView style="@style/Fleet.AuthLabel" android:text="Email" />
                <EditText android:id="@+id/etEmail" style="@style/Fleet.AuthField"
                    android:hint="name@email.com" android:inputType="textEmailAddress" android:autofillHints="emailAddress"
                    android:drawableStart="@drawable/ic_mail" android:drawablePadding="12dp" android:imeOptions="actionNext" />
                <TextView style="@style/Fleet.AuthLabel" android:text="Password" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="48dp">
                    <EditText android:id="@+id/etPassword" style="@style/Fleet.AuthField"
                        android:inputType="textPassword" android:hint="Enter your password" android:autofillHints="password"
                        android:paddingEnd="52dp" android:drawableStart="@drawable/ic_lock" android:drawablePadding="12dp"
                        android:imeOptions="actionDone" />
                    <ImageButton android:id="@+id/btnPasswordVisibility" android:layout_width="48dp" android:layout_height="48dp"
                        android:layout_gravity="end" android:padding="14dp" android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_eye" android:contentDescription="@string/show_password" />
                </FrameLayout>
            </LinearLayout>
            <TextView android:id="@+id/tvError" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:padding="12dp" android:background="@drawable/error_bg"
                android:textColor="@color/danger" android:textSize="12sp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnContinue" style="@style/Fleet.AuthButton"
                android:layout_marginTop="40dp" android:text="@string/sign_in" app:icon="@drawable/ic_arrow_right" app:iconGravity="textEnd" app:iconPadding="8dp" />
            <TextView android:id="@+id/tvGoRegister" style="@style/Fleet.AuthLink" android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp" android:text="New user? Register here" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
                android:layout_marginTop="12dp" android:orientation="horizontal">
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/border" />
                <TextView style="@style/Fleet.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:text="or continue with" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/border" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnGoogle"
                android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="16dp"
                android:insetTop="0dp" android:insetBottom="0dp" android:text="Continue with Google" android:textSize="13sp"
                android:textColor="@color/text_primary" app:backgroundTint="@color/surface" app:strokeColor="@color/border"
                app:strokeWidth="1dp" app:cornerRadius="12dp" app:icon="@drawable/ic_google" app:iconTint="@null" app:iconGravity="textStart" />
            <TextView android:id="@+id/btnServerConnection" style="@style/Fleet.AuthLink" android:layout_gravity="center_horizontal"
                android:gravity="center" android:text="@string/server_connection_title" />
            <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
            <TextView style="@style/Fleet.Caption" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:gravity="center" android:text="FleetFlow | Shuttle Management System" android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
