<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:padding="12dp" android:background="@drawable/bg_ff_card" android:orientation="vertical" android:clickable="true" android:focusable="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <ImageView android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp" android:src="@drawable/ic_vehicle" android:background="@drawable/icon_square_bg" android:contentDescription="@null" app:tint="@color/primary" />
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
   <TextView android:id="@+id/tvUnitName" style="@style/Fleet.Subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" />
   <TextView android:id="@+id/tvUnitPlate" style="@style/Fleet.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="11sp" />
  </LinearLayout>
  <TextView style="@style/Fleet.Caption" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:text="View Details →" android:textColor="@color/primary" android:textSize="11sp" />
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="36dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:layout_marginTop="10dp" android:background="@drawable/chip_bg" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
  <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_person" android:contentDescription="@null" app:tint="@color/text_secondary" />
  <TextView android:id="@+id/tvUnitDriver" style="@style/Fleet.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:textSize="12sp" />
  <TextView android:id="@+id/tvUnitStatus" style="@style/Fleet.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/badge_bg" android:textSize="10sp" android:paddingStart="7dp" android:paddingEnd="7dp" android:paddingTop="4dp" android:paddingBottom="4dp" />
 </LinearLayout>
</LinearLayout>
