<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="24dp">

        <ImageButton
            android:id="@+id/btnNotificationsBack"
            android:layout_width="36dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notifications_back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/Fleet.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/notifications_title" />

        <TextView
            android:id="@+id/tvNotificationsUnreadCount"
            style="@style/Fleet.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/chip_bg"
            android:paddingStart="14dp"
            android:paddingTop="5dp"
            android:paddingEnd="14dp"
            android:paddingBottom="5dp"
            android:textColor="@color/primary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/btnNotificationsAll"
            style="@style/Fleet.NotificationTab"
            android:minWidth="60dp"
            android:text="@string/notifications_all_tab" />

        <TextView
            android:id="@+id/btnNotificationsUnread"
            style="@style/Fleet.NotificationTab"
            android:layout_marginStart="8dp"
            android:minWidth="74dp"
            android:text="@string/notifications_unread_tab" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnNotificationsReadAll"
            style="@style/Fleet.Caption"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical|end"
            android:paddingStart="8dp"
            android:text="@string/notifications_read_all"
            android:textColor="@color/primary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="invisible" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/notificationsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/notificationCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/notificationsPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="100dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/empty_icon_bg"
                    android:contentDescription="@null"
                    android:padding="22dp"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/tvNotificationsEmpty"
                    style="@style/Fleet.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:text="@string/no_notifications" />

                <TextView
                    android:id="@+id/tvNotificationsDescription"
                    style="@style/Fleet.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/no_notifications_detail" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
