<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_ff_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAvatar"
            style="@style/Fleet.Subtitle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_ff_dot"
            android:backgroundTint="@color/ff_primary_soft"
            android:gravity="center"
            android:text="JD"
            android:textColor="@color/ff_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                style="@style/Fleet.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Driver name"
                android:textColor="@color/ff_text" />

            <TextView
                android:id="@+id/tvMeta"
                style="@style/Fleet.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="EMP-0000"
                android:textColor="@color/ff_text_muted" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            style="@style/Fleet.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ff_chip"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="On shift" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@color/ff_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Fleet.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assigned unit"
                android:textColor="@color/ff_text_muted" />

            <TextView
                android:id="@+id/tvUnit"
                style="@style/Fleet.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Shuttle 01"
                android:textColor="@color/ff_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDurationLabel"
                style="@style/Fleet.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current shift"
                android:textColor="@color/ff_text_muted" />

            <TextView
                android:id="@+id/tvDuration"
                style="@style/Fleet.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0h 00m"
                android:textColor="@color/ff_text" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>