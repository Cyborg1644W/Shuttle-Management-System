<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <com.shuttle.mobile.ui.FleetBackdropView android:layout_width="match_parent" android:layout_height="match_parent" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="36dp" android:paddingBottom="48dp">
            <include layout="@layout/view_auth_brand" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center_horizontal" />
            <LinearLayout android:id="@+id/layoutChooseRole" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView style="@style/Fleet.Display" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="32dp" android:text="Choose your role" android:textStyle="normal" />
                <TextView style="@style/Fleet.Caption" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="Choose how you will use FleetFlow." />
                <LinearLayout android:id="@+id/cardDriver" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="72dp" android:layout_marginTop="24dp" android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/card_bg" android:padding="16dp" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp"
                        android:background="@drawable/icon_square_bg" android:src="@drawable/ic_role_driver" android:contentDescription="@null" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView style="@style/Fleet.Subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Driver" />
                        <TextView style="@style/Fleet.Caption" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:text="Operate assigned shuttle routes" />
                    </LinearLayout>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" android:contentDescription="@null" />
                </LinearLayout>
                <LinearLayout android:id="@+id/cardOperator" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="72dp" android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/card_bg" android:padding="16dp" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp"
                        android:background="@drawable/icon_square_bg" android:src="@drawable/ic_role_operator" android:contentDescription="@null" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="12dp" android:orientation="vertical">
                        <TextView style="@style/Fleet.Subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Operator" />
                        <TextView style="@style/Fleet.Caption" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:text="Manage fleet, workers, and schedules" />
                    </LinearLayout>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_chevron_right" android:contentDescription="@null" />
                </LinearLayout>
                <TextView android:id="@+id/tvGoLoginChoose" style="@style/Fleet.AuthLink"
                    android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:text="Already have an account? Sign in" />
            </LinearLayout>
            <LinearLayout android:id="@+id/layoutForm" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <TextView style="@style/Fleet.Display" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="Create your\nFleetFlow account" android:textStyle="normal" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/tvRoleLabel" style="@style/Fleet.Caption" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:background="@drawable/chip_bg" android:padding="8dp"
                        android:text="Registering as Driver" android:textColor="@color/brand_600" />
                    <TextView android:id="@+id/tvChangeRole" style="@style/Fleet.AuthLink"
                        android:layout_marginStart="8dp" android:text="Change" />
                </LinearLayout>
                <TextView style="@style/Fleet.AuthLabel" android:text="Full name" />
                <EditText android:id="@+id/etFullName" style="@style/Fleet.AuthField" android:hint="Your full name"
                    android:inputType="textPersonName|textCapWords" android:autofillHints="name" android:imeOptions="actionNext" />
                <TextView style="@style/Fleet.AuthLabel" android:text="Mobile number" />
                <LinearLayout android:id="@+id/layoutPhoneBox" android:layout_width="match_parent" android:layout_height="48dp"
                    android:addStatesFromChildren="true" android:background="@drawable/input_bg" android:gravity="center_vertical"
                    android:orientation="horizontal" android:padding="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="match_parent"
                        android:gravity="center" android:background="@drawable/code_bg"
                        android:paddingStart="12dp" android:paddingEnd="12dp"
                        android:text="+63" android:textColor="@color/text_primary" android:textSize="14sp"
                        android:contentDescription="Philippines country code +63" />
                    <EditText android:id="@+id/etPhone" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                        android:background="@null" android:paddingStart="12dp" android:paddingEnd="8dp" android:hint="912 345 6789"
                        android:inputType="phone" android:autofillHints="phone" android:singleLine="true" android:textSize="14sp"
                        android:textColor="@color/text_primary" android:textColorHint="@color/text_tertiary" />
                    <ImageView android:id="@+id/ivPhoneCheck" android:layout_width="20dp" android:layout_height="20dp"
                        android:layout_marginEnd="8dp" android:src="@drawable/ic_check" android:visibility="invisible" android:contentDescription="@null" />
                </LinearLayout>
                <TextView style="@style/Fleet.AuthLabel" android:text="Email" />
                <EditText android:id="@+id/etEmail" style="@style/Fleet.AuthField" android:hint="name@email.com"
                    android:inputType="textEmailAddress" android:autofillHints="emailAddress" android:imeOptions="actionNext" />
                <TextView style="@style/Fleet.AuthLabel" android:text="Password" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="48dp">
                    <EditText android:id="@+id/etPassword" style="@style/Fleet.AuthField" android:hint="At least 6 characters"
                        android:inputType="textPassword" android:autofillHints="newPassword" android:paddingEnd="52dp" android:imeOptions="actionNext" />
                    <ImageButton android:id="@+id/btnPasswordVisibility" android:layout_width="48dp" android:layout_height="48dp"
                        android:layout_gravity="end" android:padding="14dp" android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_eye" android:contentDescription="@string/show_password" />
                </FrameLayout>
                <TextView style="@style/Fleet.AuthLabel" android:text="Confirm password" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="48dp">
                    <EditText android:id="@+id/etConfirmPassword" style="@style/Fleet.AuthField" android:hint="Re-enter your password"
                        android:inputType="textPassword" android:autofillHints="newPassword" android:paddingEnd="52dp" android:imeOptions="actionDone" />
                    <ImageButton android:id="@+id/btnConfirmPasswordVisibility" android:layout_width="48dp" android:layout_height="48dp"
                        android:layout_gravity="end" android:padding="14dp" android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_eye" android:contentDescription="@string/show_password" />
                </FrameLayout>
                <TextView android:id="@+id/tvError" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:background="@drawable/error_bg" android:padding="12dp"
                    android:textColor="@color/danger" android:textSize="12sp" android:accessibilityLiveRegion="polite" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnRegister" style="@style/Fleet.AuthButton"
                    android:text="@string/create_account" app:icon="@drawable/ic_arrow_right" app:iconGravity="textEnd" app:iconPadding="8dp" />
                <TextView android:id="@+id/tvGoLogin" style="@style/Fleet.AuthLink" android:layout_gravity="center_horizontal"
                    android:text="Already have an account? Sign in" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
