<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
   <TextView style="@style/Fleet.Display" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Fleet Units" />
   <com.google.android.material.button.MaterialButton android:id="@+id/btnFleetAddUnit" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="112dp" android:insetTop="2dp" android:insetBottom="2dp" android:text="+ Add Unit" android:textAllCaps="false" android:textSize="13sp" app:cornerRadius="10dp" app:backgroundTint="@color/brand_tint" app:strokeColor="@color/border" android:paddingStart="10dp" android:paddingEnd="10dp" />
  </LinearLayout>
  <EditText android:id="@+id/etFleetSearch" style="@style/Fleet.AuthField" android:layout_marginTop="12dp" android:hint="Search by vehicle" android:inputType="text" android:importantForAutofill="no" android:drawableStart="@drawable/ic_search" android:drawablePadding="8dp" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="12dp" android:gravity="center_vertical">
   <TextView android:id="@+id/chipAll" style="@style/Fleet.AuthLink" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="0dp" android:minHeight="36dp" android:text="All (0)" android:textSize="11sp" android:background="@drawable/tab_unselected" android:paddingStart="4dp" android:paddingEnd="4dp" />
<TextView android:id="@+id/chipOn" style="@style/Fleet.AuthLink" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp" android:minHeight="36dp" android:text="In Service (0)" android:textSize="11sp" android:background="@drawable/tab_unselected" android:paddingStart="4dp" android:paddingEnd="4dp" />
<TextView android:id="@+id/chipOff" style="@style/Fleet.AuthLink" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp" android:minHeight="36dp" android:text="Available (0)" android:textSize="11sp" android:background="@drawable/tab_unselected" android:paddingStart="4dp" android:paddingEnd="4dp" />
  </LinearLayout>
 </LinearLayout>
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="20dp" android:paddingStart="20dp" android:paddingEnd="20dp">
   <LinearLayout android:id="@+id/fleetList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
   <include android:id="@+id/fleetEmptyState" layout="@layout/view_empty_state" android:visibility="gone" />
  </LinearLayout>
 </ScrollView>
</LinearLayout>
