<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:padding="12dp" android:background="@drawable/bg_ff_card" android:orientation="vertical">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <ImageView android:id="@+id/tvSchAvatar" android:layout_width="32dp" android:layout_height="32dp" android:padding="7dp" android:src="@drawable/ic_person" android:background="@drawable/icon_square_bg" android:contentDescription="@null" app:tint="@color/primary" />
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
   <TextView android:id="@+id/tvSchName" style="@style/Fleet.Subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" />
   <TextView android:id="@+id/tvSchSub" style="@style/Fleet.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="12sp" />
  </LinearLayout>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="32dp" android:layout_marginTop="10dp" android:gravity="center_vertical">
  <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@drawable/ic_clock" android:contentDescription="@null" app:tint="@color/text_secondary" />
  <TextView android:id="@+id/tvSchTime" style="@style/Fleet.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:textSize="11sp" />
  <TextView android:id="@+id/tvSchStatus" style="@style/Fleet.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/chip_bg" android:padding="5dp" android:text="Scheduled" android:textColor="@color/primary" android:textSize="12sp" />
 </LinearLayout>
 <LinearLayout android:id="@+id/layoutShiftNotes" android:layout_width="match_parent"
     android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="10dp"
     android:orientation="vertical" android:background="@drawable/icon_square_bg"
     android:visibility="gone">
  <TextView style="@style/Fleet.Subtitle" android:layout_width="match_parent"
      android:layout_height="wrap_content" android:text="Worker notes" android:textSize="12sp" />
  <TextView android:id="@+id/tvSchNotes" style="@style/Fleet.Body" android:layout_width="match_parent"
      android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="13sp" />
 </LinearLayout>
</LinearLayout>
