<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvSchAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/circle_tint_bg"
        android:gravity="center"
        android:text="AB"
        android:textColor="@color/brand_600"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSchName"
            style="@style/Fleet.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSchSub"
            style="@style/Fleet.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Role • Station" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSchTime"
        style="@style/Fleet.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="06:00-14:00"
        android:textColor="@color/brand_600"
        android:textStyle="bold" />
</LinearLayout>