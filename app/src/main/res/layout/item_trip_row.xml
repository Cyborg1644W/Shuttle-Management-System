<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/card_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/icon_square_bg"
        android:contentDescription="@null"
        android:padding="11dp"
        android:src="@drawable/ic_vehicle"
        app:tint="@color/brand_600" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTripDate"
            style="@style/Fleet.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sat, Oct 24" />

        <TextView
            android:id="@+id/tvTripTime"
            style="@style/Fleet.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="6:00 AM - 2:00 PM" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTripDuration"
            style="@style/Fleet.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:00:00"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvTripDistance"
            style="@style/Fleet.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0.0 km" />
    </LinearLayout>

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right" />
</LinearLayout>