<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="48dp" android:padding="20dp"
    android:gravity="center_horizontal" android:orientation="vertical">
    <ImageView android:id="@+id/ivEmptyState" android:layout_width="64dp" android:layout_height="64dp"
        android:background="@drawable/empty_icon_bg" android:padding="17dp"
        app:tint="@color/primary" android:contentDescription="@null" />
    <TextView android:id="@+id/tvEmptyTitle" style="@style/Fleet.Subtitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:gravity="center" android:textSize="16sp"
        android:accessibilityLiveRegion="polite" />
    <TextView android:id="@+id/tvEmptyDescription" style="@style/Fleet.Caption"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:gravity="center" android:textSize="13sp" />
</LinearLayout>
