<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:padding="8dp" android:orientation="vertical" android:background="@drawable/bg_ff_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/btnShiftPreviousMonth" style="@style/Fleet.AuthLink"
            android:layout_width="48dp" android:text="‹" android:textSize="22sp"
            android:contentDescription="Previous month" />
        <TextView android:id="@+id/tvShiftPickerMonth" style="@style/Fleet.Subtitle"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:textSize="14sp" />
        <TextView android:id="@+id/btnShiftNextMonth" style="@style/Fleet.AuthLink"
            android:layout_width="48dp" android:text="›" android:textSize="22sp"
            android:contentDescription="Next month" />
    </LinearLayout>
    <GridLayout android:id="@+id/gridShiftPickerDates"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="7" />
</LinearLayout>
