<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_card_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circle_tint_bg"
            android:padding="11dp"
            android:src="@drawable/ic_swap"
            android:tint="@color/brand_600" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRsTitle"
                style="@style/Fleet.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reassign station" />

            <TextView
                android:id="@+id/tvRsSubtitle"
                style="@style/Fleet.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose a new station" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/listOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRsCancel"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="4dp"
        android:text="Cancel"
        android:textColor="@color/text_secondary"
        app:cornerRadius="@dimen/radius_control" />
</LinearLayout>