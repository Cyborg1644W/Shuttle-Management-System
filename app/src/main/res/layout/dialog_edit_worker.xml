<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_card_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivEwIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circle_tint_bg"
            android:padding="11dp"
            android:src="@drawable/ic_edit"
            android:tint="@color/brand_600" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEwTitle"
                style="@style/Fleet.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Worker Profile" />

            <TextView
                android:id="@+id/tvEwSubtitle"
                style="@style/Fleet.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Update this worker's details" />
        </LinearLayout>
    </LinearLayout>

    <!-- Role toggle (only when adding a worker) -->
    <LinearLayout
        android:id="@+id/layoutEwRole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvEwDriver"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/tab_selected"
            android:gravity="center"
            android:text="Driver"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvEwOperator"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/tab_unselected"
            android:gravity="center"
            android:text="Operator"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        style="@style/Fleet.Overline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Full name" />

    <EditText
        android:id="@+id/etEwName"
        style="@style/Fleet.Body"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/input_bg"
        android:hint="e.g. Lea Ramos"
        android:inputType="textPersonName|textCapWords"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

    <TextView
        style="@style/Fleet.Overline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Employee ID" />

    <EditText
        android:id="@+id/etEwEmp"
        style="@style/Fleet.Body"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/input_bg"
        android:hint="e.g. EMP-0377"
        android:inputType="textCapCharacters"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

    <TextView
        style="@style/Fleet.Overline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Mobile number (+63)" />

    <EditText
        android:id="@+id/etEwPhone"
        style="@style/Fleet.Body"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/input_bg"
        android:hint="9XX XXX XXXX"
        android:inputType="phone"
        android:maxLength="15"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp" />

    <TextView
        android:id="@+id/tvEwError"
        style="@style/Fleet.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text=""
        android:textColor="@color/danger"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEwCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            app:cornerRadius="@dimen/radius_control" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEwSave"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Save"
            app:backgroundTint="@color/brand_600"
            app:cornerRadius="@dimen/radius_control" />
    </LinearLayout>
</LinearLayout>