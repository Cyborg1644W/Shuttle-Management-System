<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
  <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/logo" android:contentDescription="@null" />
  <TextView style="@style/Fleet.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="5dp" android:text="@string/operator_wordmark" android:fontFamily="@font/arimo_variable" android:textSize="18sp" />
  <include layout="@layout/view_notification_bell" />
  <ImageButton android:id="@+id/tvHeaderAvatar" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:padding="10dp" android:background="@drawable/bell_box_bg" android:src="@drawable/ic_profile_outline" android:contentDescription="Account menu" app:tint="@color/text_primary" />
 </LinearLayout>
 <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" />
 <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <ScrollView android:id="@+id/pageWorkers" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
     <TextView style="@style/Fleet.Display" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Workers" />
     <com.google.android.material.button.MaterialButton android:id="@+id/btnFleetConnection" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="+ Invite Worker" android:textAllCaps="false" android:textSize="11sp" app:cornerRadius="8dp" app:backgroundTint="@color/brand_tint" app:strokeColor="@color/border" android:paddingStart="10dp" android:paddingEnd="10dp" />
    </LinearLayout>
    <EditText android:id="@+id/etSearch" style="@style/Fleet.AuthField" android:layout_marginTop="12dp" android:hint="Search by name or ID" android:drawableStart="@drawable/ic_search" android:drawablePadding="8dp" android:inputType="text" android:importantForAutofill="no" android:imeOptions="actionDone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="12dp" android:gravity="center_vertical">
     <TextView android:id="@+id/chipAll" style="@style/Fleet.AuthLink" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="0dp" android:minHeight="36dp" android:text="All (0)" android:textSize="11sp" android:background="@drawable/tab_unselected" android:paddingStart="4dp" android:paddingEnd="4dp" />
<TextView android:id="@+id/chipDrivers" style="@style/Fleet.AuthLink" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp" android:minHeight="36dp" android:text="On Duty (0)" android:textSize="11sp" android:background="@drawable/tab_unselected" android:paddingStart="4dp" android:paddingEnd="4dp" />
<TextView android:id="@+id/chipOperators" style="@style/Fleet.AuthLink" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp" android:minHeight="36dp" android:text="Off Duty (0)" android:textSize="11sp" android:background="@drawable/tab_unselected" android:paddingStart="4dp" android:paddingEnd="4dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/listContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" />
   </LinearLayout>
  </ScrollView>
  <include android:id="@+id/pageSchedule" layout="@layout/page_schedule" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
 </FrameLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/tabbar_bg" android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="4dp">
 <LinearLayout android:id="@+id/navDashboard" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><ImageView android:id="@+id/ivNavDashboard" android:layout_width="48dp" android:layout_height="28dp" android:padding="5dp" android:src="@drawable/ic_home" android:contentDescription="@null" app:tint="@color/text_secondary" /><TextView android:id="@+id/tvNavDashboard" style="@style/Fleet.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home" android:textSize="10sp" /></LinearLayout><LinearLayout android:id="@+id/navFleet" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><ImageView android:id="@+id/ivNavFleet" android:layout_width="48dp" android:layout_height="28dp" android:padding="5dp" android:src="@drawable/ic_vehicle" android:contentDescription="@null" app:tint="@color/text_secondary" /><TextView android:id="@+id/tvNavFleet" style="@style/Fleet.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fleet" android:textSize="10sp" /></LinearLayout><LinearLayout android:id="@+id/navWorkers" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><ImageView android:id="@+id/ivNavWorkers" android:layout_width="48dp" android:layout_height="28dp" android:padding="5dp" android:src="@drawable/ic_nav_workers" android:contentDescription="@null" app:tint="@color/text_secondary" /><TextView android:id="@+id/tvNavWorkers" style="@style/Fleet.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Workers" android:textSize="10sp" /></LinearLayout><LinearLayout android:id="@+id/navSchedule" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><ImageView android:id="@+id/ivNavSchedule" android:layout_width="48dp" android:layout_height="28dp" android:padding="5dp" android:src="@drawable/ic_nav_schedule" android:contentDescription="@null" app:tint="@color/text_secondary" /><TextView android:id="@+id/tvNavSchedule" style="@style/Fleet.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Schedule" android:textSize="10sp" /></LinearLayout>
 </LinearLayout>
</LinearLayout>
