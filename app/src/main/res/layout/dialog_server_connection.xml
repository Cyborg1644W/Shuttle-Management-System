<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="22dp"
        android:focusableInTouchMode="true">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView
                android:layout_width="42dp" android:layout_height="42dp"
                android:background="@drawable/icon_square_bg" android:padding="10dp"
                android:src="@drawable/ic_server" android:contentDescription="@null" />
            <TextView
                style="@style/Fleet.Title"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="12dp"
                android:text="@string/server_connection_title" android:textSize="18sp" />
        </LinearLayout>
        <RadioGroup
            android:id="@+id/serverMode"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="12dp">
            <RadioButton
                android:id="@+id/serverAutomatic"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" />
            <RadioButton
                android:id="@+id/serverCustom"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:labelFor="@+id/etServerAddress"
                android:text="@string/server_custom" />
        </RadioGroup>
        <EditText
            android:id="@id/etServerAddress" style="@style/Fleet.AuthField"
            android:hint="@string/server_address_hint" android:inputType="textUri"
            android:imeOptions="actionDone" android:selectAllOnFocus="true"
            android:importantForAutofill="no" />
        <TextView
            android:id="@+id/tvServerAddressError" style="@style/Fleet.Caption"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textColor="@color/error"
            android:accessibilityLiveRegion="polite" android:visibility="gone" />
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="16dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelServerAddress"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minHeight="48dp"
                android:text="@android:string/cancel" android:textAllCaps="false"
                app:cornerRadius="12dp" app:strokeColor="@color/border" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveServerAddress"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minHeight="48dp" android:layout_marginStart="8dp"
                android:text="@string/server_connection_save" android:textAllCaps="false"
                android:textColor="@color/white" app:backgroundTint="@color/primary" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
