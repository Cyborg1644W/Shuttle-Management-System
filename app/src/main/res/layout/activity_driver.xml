<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
  <ImageView android:layout_width="25dp" android:layout_height="25dp" android:src="@drawable/logo" android:contentDescription="@null" />
  <TextView android:id="@+id/layoutHeaderTitle" style="@style/Fleet.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="5dp" android:text="@string/driver_wordmark" android:fontFamily="@font/arimo_variable" android:textSize="18sp" />
  <FrameLayout android:id="@+id/flBell" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bell_box_bg" android:clickable="true" android:focusable="true" android:contentDescription="Notifications">
   <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_bell" android:contentDescription="@null" app:tint="@color/text_primary" />
   <View android:id="@+id/viewDot" android:layout_width="6dp" android:layout_height="6dp" android:layout_gravity="top|end" android:layout_margin="7dp" android:background="@drawable/dot_red" android:visibility="gone" />
  </FrameLayout>
  <ImageButton android:id="@+id/btnDriverProfile" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:padding="10dp" android:background="@drawable/bell_box_bg" android:src="@drawable/ic_profile_outline" android:contentDescription="Account menu" app:tint="@color/text_primary" />
 </LinearLayout>
 <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" />
 <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <ScrollView android:id="@+id/pageHome" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical">
    <TextView android:id="@+id/tvGreeting" style="@style/Fleet.Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="23sp" />
    <TextView android:id="@+id/tvHello" style="@style/Fleet.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textSize="12sp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnTerminal" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_gravity="end" android:text="View Terminal →" android:textAllCaps="false" android:textSize="11sp" />
    <LinearLayout android:id="@+id/layoutDriverNoTerminal" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:background="@drawable/bg_ff_card" android:orientation="vertical" android:gravity="center" android:visibility="gone">
     <ImageView android:layout_width="56dp" android:layout_height="56dp" android:padding="14dp" android:src="@drawable/ic_pin" android:background="@drawable/avatar_header_bg" android:contentDescription="@null" app:tint="@color/primary" />
     <TextView style="@style/Fleet.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="12dp" android:text="No terminal joined" android:textSize="17sp" />
     <TextView style="@style/Fleet.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="6dp" android:text="Enter a code from your operator to join." android:textSize="12sp" />
     <com.google.android.material.button.MaterialButton android:id="@+id/btnJoinTerminal" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="14dp" android:text="+ Join a Terminal" android:textAllCaps="false" app:backgroundTint="@color/brand_tint" app:strokeColor="@color/border" app:cornerRadius="8dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:padding="14dp" android:background="@drawable/bg_ff_card" android:orientation="vertical">
     <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical"><ImageView android:layout_width="28dp" android:layout_height="28dp" android:padding="5dp" android:background="@drawable/icon_square_bg" android:src="@drawable/ic_pin" android:contentDescription="@null" app:tint="@color/primary" /><TextView style="@style/Fleet.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Terminal" android:textSize="12sp" /><TextView android:id="@+id/tvTerminal" style="@style/Fleet.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/badge_bg" android:text="Unassigned" android:textSize="10sp" android:textColor="@color/primary" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" /></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical"><ImageView android:layout_width="28dp" android:layout_height="28dp" android:padding="5dp" android:background="@drawable/icon_square_bg" android:src="@drawable/ic_clock" android:contentDescription="@null" app:tint="@color/primary" /><TextView style="@style/Fleet.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Duty status" android:textSize="12sp" /><TextView android:id="@+id/tvStatusBadge" style="@style/Fleet.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/badge_bg" android:text="Unassigned" android:textSize="10sp" android:textColor="@color/primary" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" /></LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:gravity="center_vertical"><ImageView android:layout_width="28dp" android:layout_height="28dp" android:padding="5dp" android:background="@drawable/icon_square_bg" android:src="@drawable/ic_vehicle" android:contentDescription="@null" app:tint="@color/primary" /><TextView style="@style/Fleet.Body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Vehicle assignment" android:textSize="12sp" /><TextView android:id="@+id/tvVehicle" style="@style/Fleet.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/badge_bg" android:text="Unassigned" android:textSize="10sp" android:textColor="@color/primary" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp" /></LinearLayout>
     <TextView android:id="@+id/tvTimer" style="@style/Fleet.Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="8dp" android:text="00:00:00" android:visibility="gone" />
     <com.google.android.material.button.MaterialButton android:id="@+id/btnShift" style="@style/Fleet.AuthButton" android:layout_marginTop="10dp" android:text="▷ Start Shift" />
     <TextView android:id="@+id/tvStatusHint" style="@style/Fleet.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textSize="11sp" android:accessibilityLiveRegion="polite" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:padding="14dp" android:background="@drawable/bg_ff_card" android:orientation="vertical">
     <TextView style="@style/Fleet.Subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Live Route" android:textSize="13sp" />
     <TextView android:id="@+id/tvDriverRouteEmpty" style="@style/Fleet.Body" android:layout_width="match_parent" android:layout_height="120dp" android:gravity="center" android:text="No route assigned\nYour recorded route appears when location updates are received." android:textSize="12sp" />
     <com.shuttle.mobile.ui.PureJavaMapCanvas android:id="@+id/mapView" android:layout_width="match_parent" android:layout_height="190dp" android:layout_marginTop="10dp" android:visibility="gone" />
     <LinearLayout android:id="@+id/layoutDriverLiveStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:visibility="gone">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center"><TextView style="@style/Fleet.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Distance" android:textSize="10sp" /><TextView android:id="@+id/tvStatDistance" style="@style/Fleet.Subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="14sp" /></LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center"><TextView style="@style/Fleet.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Stops" android:textSize="10sp" /><TextView android:id="@+id/tvStatStops" style="@style/Fleet.Subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="14sp" /></LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center"><TextView style="@style/Fleet.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Speed" android:textSize="10sp" /><TextView android:id="@+id/tvStatSpeed" style="@style/Fleet.Subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="14sp" /></LinearLayout>
     </LinearLayout>
    </LinearLayout>
   </LinearLayout>
  </ScrollView>
  <ScrollView android:id="@+id/pageTrips" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical">
    <TextView style="@style/Fleet.Display" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Recent Trips" />
    <LinearLayout android:id="@+id/listTrips" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical" />
    <include android:id="@+id/tripsEmptyState" layout="@layout/view_empty_state" android:visibility="gone" />
   </LinearLayout>
  </ScrollView>
  <include android:id="@+id/pageDriverSchedule" layout="@layout/page_schedule" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
 </FrameLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/tabbar_bg" android:orientation="horizontal" android:paddingTop="4dp" android:paddingBottom="4dp">
  <LinearLayout android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><ImageView android:id="@+id/ivNavHome" android:layout_width="48dp" android:layout_height="28dp" android:padding="5dp" android:src="@drawable/ic_home" android:contentDescription="@null" app:tint="@color/text_secondary" /><TextView android:id="@+id/tvNavHome" style="@style/Fleet.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home" android:textSize="10sp" /></LinearLayout><LinearLayout android:id="@+id/navTrips" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><ImageView android:id="@+id/ivNavTrips" android:layout_width="48dp" android:layout_height="28dp" android:padding="5dp" android:src="@drawable/ic_vehicle" android:contentDescription="@null" app:tint="@color/text_secondary" /><TextView android:id="@+id/tvNavTrips" style="@style/Fleet.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fleet" android:textSize="10sp" /></LinearLayout><LinearLayout android:id="@+id/navDriverSchedule" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true"><ImageView android:id="@+id/ivNavDriverSchedule" android:layout_width="48dp" android:layout_height="28dp" android:padding="5dp" android:src="@drawable/ic_nav_schedule" android:contentDescription="@null" app:tint="@color/text_secondary" /><TextView android:id="@+id/tvNavDriverSchedule" style="@style/Fleet.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Schedule" android:textSize="10sp" /></LinearLayout>
 </LinearLayout>
</LinearLayout>
